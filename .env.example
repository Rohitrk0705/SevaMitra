# SevaMithra environment configuration
# Copy this file to .env and edit values. .env is gitignored.

# Featherless.ai configuration — hosted LLM inference
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# LLM call defaults (all optional)
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
